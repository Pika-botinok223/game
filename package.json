{
  "name": "ave-maria",
  "productName": "Ave Maria",
  "version": "1.0.0",
  "description": "Ave Maria - a short Half-Life / Portal style first-person story game.",
  "author": "Ave Maria Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist:mac": "vite build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "test": "node tests/smoke.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.avemaria.dx90",
    "productName": "Ave Maria",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Ave Maria"
    }
  }
}
